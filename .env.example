# Most pwa-app projects need no environment variables — Dexie/IndexedDB
# is local to the browser and requires no connection string or API key.
#
# The two sections below are populated only when a project's Hedgehog
# intake turned on sync or remote entities (see hedgehog-bootstrap-pwa-app-core).

# --- Sync (Dexie Cloud), only if this project's .hedgehog/addons.yaml has sync: true ---
# NEXT_PUBLIC_DEXIE_CLOUD_URL=

# --- Remote entities (Supabase), only if this project declared at least one --remote entity ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
